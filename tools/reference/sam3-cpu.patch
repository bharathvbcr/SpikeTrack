diff --git a/sam3/_device.py b/sam3/_device.py
new file mode 100644
index 0000000..f27e733
--- /dev/null
+++ b/sam3/_device.py
@@ -0,0 +1,9 @@
+"""Device for placements the upstream code hardcodes to CUDA (SpikeTrack CPU patch)."""
+
+import os
+
+import torch
+
+
+def _sam3_device():
+    return torch.device(os.environ.get("SAM3_DEVICE", "cuda"))
